# ======================================================================
# 1. Runtime and public URLs
# PUBLIC_BASE_URL: the public https origin LINE and users reach (e.g. https://host or https://host/cloudnex-connect). LINE refuses http.
# APP_ENV: development | staging | production. NODE_ENV: development locally, production on any server image.
# PUBLIC_ADMIN_BASE: path where Admin is mounted (/admin locally; behind a path prefix, see documents/ENVIRONMENTS.md).
# ======================================================================
PORT=8080
# Local:    APP_ENV=development  NODE_ENV=development
# Staging:  APP_ENV=staging      NODE_ENV=production   (VPS image; required)
# Delivery: APP_ENV=production   NODE_ENV=production
APP_ENV=staging
NODE_ENV=production
LOG_LEVEL=info
DEFAULT_LANGUAGE=en
TENANT_KEY=default
PUBLIC_BASE_URL=https://amardhaka.io/cloudnex-connect
# Local HTTPS clone of staging path: PUBLIC_BASE_URL=https://site.local/cloudnex-connect
# Local: /admin. VPS: PUBLIC_BASE_URL=https://amardhaka.io/cloudnex-connect and PUBLIC_ADMIN_BASE=/admin (Node mounts /cloudnex-connect/admin)
PUBLIC_ADMIN_BASE=/admin
# Legacy; GET redirects to Admin /testing
PUBLIC_DEMO_BASE=/demo
MAX_JSON_BODY=64kb
READYZ_TIMEOUT_MS=2500
SHUTDOWN_TIMEOUT_MS=10000
# Where the Admin Logs page reads the VPS log archive (read-only mount of /var/log/cloudnex-connect).
# APP_LOG_DIR=/var/log/cloudnex-connect

# ======================================================================
# 2. LINE: default channel (POST /webhook; Sales falls back to it if no Sales-only credentials)
# Where: https://developers.line.biz -> Provider -> your Messaging API channel.
# LINE_CHANNEL_ID and LINE_CHANNEL_SECRET: Basic settings tab (Channel ID, Channel secret).
# LINE_CHANNEL_ACCESS_TOKEN: Messaging API tab -> Channel access token (long-lived) -> Issue. Reissuing revokes the old token.
# LINE_CHANNEL_BASIC_ID: Messaging API tab -> Bot basic ID (keep the leading @).
# Admin -> Channels can also save and verify these (an Admin value overrides this file).
# ======================================================================
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# OA Basic ID (@handle). Keep the leading @.
LINE_CHANNEL_BASIC_ID=@938qytwi
# LINE_CHANNEL_DEFAULT_SERVICES=

# ======================================================================
# 3. LINE: Sales OA (POST /webhook/sales)
# Same console steps as the default channel, but for the Sales OA channel.
# Set the channel Webhook URL to <PUBLIC_BASE_URL origin>/webhook/sales and turn "Use webhook" on.
# Leave SECRET/ACCESS_TOKEN empty only if Sales should reuse the default channel (not recommended).
# _SERVICES: comma-separated service keys enabled for this OA. _RICH_MENU_JSON: output of npm run rich-menu:upload.
# ======================================================================
LINE_CHANNEL_SALES_ID=
LINE_CHANNEL_SALES_SECRET=
LINE_CHANNEL_SALES_ACCESS_TOKEN=
LINE_CHANNEL_SALES_BASIC_ID=@938qytwi
LINE_CHANNEL_SALES_SERVICES=
LINE_CHANNEL_SALES_RICH_MENU_JSON=

# ======================================================================
# 4. LINE: Customer OA (POST /webhook/customer)
# Same console steps, for the Customer OA channel. Webhook URL: <origin>/webhook/customer.
# CUSTOMER_COMMERCE: quote (default) or shop. Shop needs Odoo website_sale and ODOO_WEBSITE_ID.
# LINE_CHANNEL_CUSTOMER_KEYBOARD_RICH_MENU: blank rich-menu id shown during quantity/form input (richmenu-... from rich-menu:upload).
# ======================================================================
LINE_CHANNEL_CUSTOMER_ID=
LINE_CHANNEL_CUSTOMER_SECRET=
LINE_CHANNEL_CUSTOMER_ACCESS_TOKEN=
LINE_CHANNEL_CUSTOMER_BASIC_ID=@724tneri
LINE_CHANNEL_CUSTOMER_SERVICES=commerce,catalog
LINE_CHANNEL_CUSTOMER_RICH_MENU_JSON=
# Blank/keyboard rich menu for qty forms (en.keyboard in JSON, or this id). Without it, unlink still shows the OA default tray.
LINE_CHANNEL_CUSTOMER_KEYBOARD_RICH_MENU=
CUSTOMER_QTY_CHIPS=10,15,20,25,30,35,40,45,50
# Customer OA exclusive mode: quote (default) or shop. Shop needs website_sale installed and ODOO_WEBSITE_ID.
# Shop Pay web UI is GET /shop/pay (HMAC host). Odoo should POST /ops/odoo-hook { "event": "payment.done", "orderId" } after provider success.
CUSTOMER_COMMERCE=

# ======================================================================
# 5. LINE: bot behavior and rich menus
# LINE_RICH_MENU_EN / _TH / _JSON: printed by npm run rich-menu:upload after you upload the tray images (ids are per OA).
# LINE_WEBHOOK_ASYNC=true needs REDIS_URL and RUN_BULLMQ_WORKER=true (replies are sent by a worker).
# LINE_AGENT_NAME_EN/TH: persona name shown as the reply prefix.
# ======================================================================
LINE_AGENT_NAME_EN=Sora
LINE_AGENT_NAME_TH=โซระ
# After npm run rich-menu:upload — EN Language gold at rest; TH Language idle white.
LINE_RICH_MENU_EN=
LINE_RICH_MENU_TH=
# JSON map from npm run rich-menu:upload — active cell PNGs after a tray tap.
LINE_RICH_MENU_JSON=
LINE_WEBHOOK_ASYNC=false
# After this idle period, the next inbound (with no pendingFlow) returns persona Home
LINE_IDLE_HOME_SECONDS=3600
LINE_MEDIA_MAX_BYTES=10485760
LINE_GROUP_ROOMS=false
LINE_SECOND_WEBHOOK=false
GUIDED_FORM_TTL_MINUTES=60
SALES_SESSION_TTL_HOURS=24
SALES_IDLE_SIGNOUT_SECONDS=3600

# ======================================================================
# 6. Admin access and secrets
# ADMIN_USER_ID / SUPER_ADMIN_USER_IDS: comma-separated LINE user ids (U...). Your own id: LINE Developers -> Basic settings -> "Your user ID".
# ADMIN_SECRET_TOKEN, OPS_API_TOKEN, CONNECT_BOOTSTRAP_TOKEN: generate yourself, e.g. openssl rand -hex 32. Keep them private.
# SECRETS_ENCRYPTION_KEY: generate once (openssl rand -hex 32) and back it up; without it Admin cannot store encrypted channel credentials, and losing it makes stored ones unreadable.
# ADMIN_CONFIG_LOCK=true locks Admin edits except LINE channel credentials. ADMIN_ALLOWED_CIDRS: optional IP allowlist.
# ======================================================================
# Comma-separated LINE user IDs allowed to receive the admin role via ADMIN ENABLE.
# Required (and must include the requesting user) for ADMIN ENABLE to succeed at all.
ADMIN_USER_ID=
SUPER_ADMIN_USER_IDS=
# Jobs page + CLI jobs:* (not the Admin login token)
ADMIN_SECRET_TOKEN=
OPS_API_TOKEN=
CONNECT_BOOTSTRAP_TOKEN=
SECRETS_ENCRYPTION_KEY=
SECRET_REVEAL_TTL_SECONDS=10
ADMIN_CONFIG_LOCK=true
ADMIN_ALLOWED_CIDRS=

# ======================================================================
# 7. Admin sign-in: LINE Login, Okta, SAML (optional)
# LINE_LOGIN_CHANNEL_ID / _SECRET: a separate LINE Login channel (LINE Developers -> Provider -> LINE Login channel -> Basic settings). Callback URL: <origin>/admin/api/auth/line/callback.
# OKTA_*: Okta Admin -> Applications -> your OIDC app (Issuer, Client ID, Client secret). OKTA_LINE_CLAIM names the claim holding the LINE user id.
# SAML_*: your IdP metadata (SSO URL, signing certificate) and the SP entity id you register with the IdP.
# ======================================================================
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_LINE_CLAIM=line_user_id
OKTA_LINE_USER_MAP=
SAML_IDP_SSO_URL=
SAML_IDP_CERT=
SAML_SP_ENTITY_ID=
SAML_LINE_ATTRIBUTE=line_user_id

# ======================================================================
# 8. Odoo / ERP
# ODOO_URL / ODOO_DB: your Odoo base URL and database name.
# ODOO_USERNAME + ODOO_API_KEY: Odoo -> user menu -> Preferences -> Account Security -> New API Key (the user needs the sales/product access you expect).
# One Odoo database per process; partner ids in Firestore belong to the previous DB until users VERIFY again.
# ======================================================================
# fails closed at startup rather than silently no-op'ing (src/erp/registry.ts).
ERP_PROVIDER=odoo
# current LINE OA, keep LINE_CHANNEL_* and set these four to the lab instance,
# then recreate the container. Partner ids in Firestore still belong to the
# previous DB until users VERIFY again.
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_WEBSITE_ID=
ODOO_RPC_TIMEOUT_MS=7000
ODOO_READ_RETRY_ATTEMPTS=3
ODOO_READ_RETRY_BASE_DELAY_MS=250
# Retries for idempotent writes only (update/delete); creates are never
# blindly retried — see src/services/odoo.ts reconciliation comments.
ODOO_WRITE_RETRY_ATTEMPTS=2
# ODOO_LOGIN_CACHE_MS=
# PRODUCT_CATALOG_CACHE_MS=
# PRODUCT_IMAGE_CACHE_MS=

# ======================================================================
# 9. Odoo user verification (OTP and magic link)
# No external value needed; tune only if the defaults do not fit. PUBLIC_BASE_URL (above) is used for the magic link.
# ======================================================================
ODOO_VERIFY_OTP_TTL_MINUTES=10
# Max wrong OTP guesses before the verification challenge is invalidated
ODOO_VERIFY_OTP_MAX_ATTEMPTS=5
ODOO_VERIFY_DEBUG_INCLUDE_OTP=false
# ACTION_OTP_TTL_MINUTES=

# ======================================================================
# 10. Group-Buy rollout
# Feature flags; no external value.
# ======================================================================
GROUPBUY_ENABLED=false
GROUPBUY_ROLLOUT_PERCENT=0
GROUPBUY_ALLOWED_USER_IDS=
# GROUPBUY_DEFAULT_HOURS=

# ======================================================================
# 11. Data stores, queue and storage
# GOOGLE_CLOUD_PROJECT: Google Cloud Console project id (Firestore/BigQuery).
# GOOGLE_APPLICATION_CREDENTIALS_JSON: only on a non-GCP host. GCP Console -> IAM -> Service accounts -> Keys -> JSON, pasted as one line.
# MONGODB_URI: Atlas/Mongo connection string; required when MONGO_USERS=true.
# REDIS_URL: redis://host:6379 (the staging compose starts Redis for you).
# ======================================================================
GOOGLE_CLOUD_PROJECT=
# Only needed on a non-GCP host (e.g. a Railway test deploy), where
# Application Default Credentials aren't available automatically the way
# they are on Cloud Run. Paste a Firestore-capable service account's JSON
# key as a single-line string. Leave unset on Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Required when MONGO_USERS=true (identity SoR). Never stores Odoo masters.
MONGODB_URI=
# MONGO_DB_NAME=cns_line_oa
MONGO_VECTOR_ENABLED=false
MONGO_USERS=false
REDIS_URL=
RATE_LIMIT_STORE=memory
RATE_LIMIT_REDIS_PREFIX=rl:
RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS=3000
# RATE_STORE_MAX_KEYS=
RUN_BULLMQ_WORKER=false
# BULLMQ_PREFIX=cns
# Requires REDIS_URL + RUN_BULLMQ_WORKER=true. Staging compose on the VPS sets
# both and starts Redis. Returns HTTP 200 then workers call replyMessage
# (or pushMessage if the 25s reply token expired). Leave false on Cloud Run
# without a queue. Native tray still replies first; Odoo catalog may push
# after NAV commerce on a cache miss.
# push after NAV commerce on a cache miss. Re-upload assets/rich-menu PNGs into
# LINE_RICH_MENU_JSON / LINE_CHANNEL_CUSTOMER_RICH_MENU_JSON after tray IA changes.
OPS_JOBS_ASYNC=false
USER_STATE_CACHE_MAX=10000
USER_STATE_CACHE_TTL_MS=3600000
GCS_MEDIA_BUCKET=

# ======================================================================
# 12. AI providers (optional)
# GOOGLE_AI_STUDIO_API_KEY / GEMINI_API_KEY: https://aistudio.google.com/app/apikey. On GCP, Vertex uses the service account instead.
# GROQ_API_KEY: https://console.groq.com/keys. OPENROUTER_API_KEY: https://openrouter.ai/keys.
# OLLAMA_* / FLOWISE_*: your own LAN/VPS services (Admin only proxies authed prompts).
# AI_OFF=true disables every AI call.
# ======================================================================
GOOGLE_CLOUD_LOCATION=
GOOGLE_AI_STUDIO_API_KEY=
# GEMINI_API_KEY=
AI_OFF=false
GROQ_API_KEY=
OPENROUTER_API_KEY=
# clawframework integration (optional) — routes free-form LINE chat through
# clawframework's call_llm (Groq/OpenRouter) instead of Gemini.
#   CLAWFRAMEWORK_ENABLED=true
#   CLAWFRAMEWORK_PROVIDER=groq|openrouter
#   CLAWFRAMEWORK_SEARCH=true|false
#   CLAWFRAMEWORK_PYTHON=/path/to/.venv/bin/python
CLAWFRAMEWORK_ENABLED=false
# CLAWFRAMEWORK_HTTP_URL=
# CLAWFRAMEWORK_MOCK=
# Admin Home studio (optional). Ollama and Flowise stay on the VPS/LAN; Admin only proxies OPS-authed prompts.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
FLOWISE_BASE_URL=
FLOWISE_CHATFLOW_ID=
FLOWISE_API_KEY=
# SKILLS_DIR=

# ======================================================================
# 13. Feature toggles, demo and test tools
# ENABLE_WEBHOOK_TEST needs WEBHOOK_TEST_TOKEN on a production image; ignored when APP_ENV=production.
# DEMO_CONTROL_TOKEN / DEMO_SESSION_SECRET: generate yourself (openssl rand -hex 32).
# ======================================================================
ENABLED_SERVICES=commerce,directory,catalog,reporting,groupBuy
# Comma-separated command prefixes to hide and reject, e.g. QUOTE ADD,QUOTE EDIT
DISABLED_COMMANDS=
# Optional: keep webhook-test private in production
ENABLE_WEBHOOK_TEST=true
WEBHOOK_TEST_TOKEN=
ENABLE_DEMO_CONTROL_PANEL=true
DEMO_CONTROL_TOKEN=
DEMO_SESSION_SECRET=
DEMO_SESSION_TTL_MINUTES=30
DEMO_SESSION_ROTATE_GRACE_MINUTES=30
DEMO_SESSION_CONFIG_KEY=demoSessionSecretsV1
ALLOW_DEMO_HEADER_TOKEN_FALLBACK=false
ENABLE_API_DOCS=true
ENABLE_GRAPHQL=true
GRAPHQL_LINE_INGEST=false
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ======================================================================
# 14. Media scanning (optional)
# CLAMAV_URL: your ClamAV REST endpoint. AV_SCAN_REQUIRED=true rejects uploads if the scanner is down.
# ======================================================================
CLAMAV_URL=
AV_SCAN_REQUIRED=false

# ======================================================================
# 15. Audit trail archive and rotation
# See documents/AUDIT_LOG_POLICY.md. Archive needs GOOGLE_CLOUD_PROJECT; rotation no-ops safely without it.
# ======================================================================
# Requires GOOGLE_CLOUD_PROJECT (above) for the BigQuery archive; rotation
# safely no-ops (archives/deletes nothing) if that isn't configured.
AUDIT_RETENTION_DAYS=30
AUDIT_ARCHIVE_ENABLED=true
AUDIT_ARCHIVE_DATASET=ops_archive
AUDIT_ARCHIVE_TABLE=audit_log
AUDIT_ROTATE_BATCH_SIZE=500
AUDIT_ROTATE_MAX_BATCHES=20

# ======================================================================
# 16. Pricing and cost model
# Internal estimates for the Admin cost/pricing views; no external value.
# ======================================================================
AI_INPUT_COST_PER_1M_USD=0.35
AI_OUTPUT_COST_PER_1M_USD=1.25
LINE_MESSAGE_COST_USD=0.0012
ODOO_RPC_COST_USD=0.0008
FIRESTORE_READ_COST_USD=0.000002
FIRESTORE_WRITE_COST_USD=0.00001
INFRA_FIXED_MONTHLY_USD=120
SUPPORT_PER_CUSTOMER_MONTHLY_USD=18
PRICING_BASE_MARKUP_PERCENT=40
PRICING_ADVANCED_MARKUP_PERCENT=70
PRICING_ENTERPRISE_MARKUP_PERCENT=120
PRICING_RISK_BUFFER_PERCENT=12
PRICING_TARGET_MARGIN_PERCENT=65
PRICING_MONTHLY_BUDGET_CAP_USD=2500
