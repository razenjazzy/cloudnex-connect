# Staging env for amardhaka.io. Lives on the server at /opt/cloudnex-connect/.env
# Do not commit real values.
# Runtime image: DOCKER_IMAGE=razenjazzy/cloudnex-connect:staging (VPS pulls; secrets stay here)

APP_ENV=staging
NODE_ENV=production
PORT=8080
ERP_PROVIDER=odoo
DEFAULT_LANGUAGE=en
PUBLIC_BASE_URL=https://amardhaka.io

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_ID=
LINE_CHANNEL_BASIC_ID=@938qytwi
# Cloudnex Sales webhook: https://amardhaka.io/webhook/sales
# Uses LINE_CHANNEL_* above unless LINE_CHANNEL_SALES_* is filled.
LINE_CHANNEL_SALES_SECRET=
LINE_CHANNEL_SALES_ACCESS_TOKEN=
LINE_CHANNEL_SALES_BASIC_ID=@938qytwi
LINE_CHANNEL_SALES_SERVICES=
LINE_CHANNEL_SALES_RICH_MENU_JSON=
LINE_AGENT_NAME_EN=Sora
LINE_AGENT_NAME_TH=โซระ
LINE_RICH_MENU_EN=
LINE_RICH_MENU_TH=
LINE_RICH_MENU_JSON=
ADMIN_USER_ID=

# Cloudnex Customer — webhook https://amardhaka.io/webhook/customer
LINE_CHANNEL_CUSTOMER_SECRET=
LINE_CHANNEL_CUSTOMER_ACCESS_TOKEN=
LINE_CHANNEL_CUSTOMER_BASIC_ID=@724tneri
LINE_CHANNEL_CUSTOMER_SERVICES=commerce,catalog
LINE_CHANNEL_CUSTOMER_RICH_MENU_JSON=

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_AI_STUDIO_API_KEY=

ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

OPS_API_TOKEN=
DEMO_CONTROL_TOKEN=
DEMO_SESSION_SECRET=
WEBHOOK_TEST_TOKEN=
ENABLE_DEMO_CONTROL_PANEL=true
ENABLE_WEBHOOK_TEST=true
ENABLE_GRAPHQL=true
ENABLE_API_DOCS=true
ALLOW_DEMO_HEADER_TOKEN_FALLBACK=false

RATE_LIMIT_STORE=memory
# Compose injects Redis + LINE_WEBHOOK_ASYNC=true; this line is ignored when the container uses environment:.
LINE_WEBHOOK_ASYNC=false
OPS_JOBS_ASYNC=false
RUN_BULLMQ_WORKER=false
MONGO_VECTOR_ENABLED=false
CLAWFRAMEWORK_ENABLED=false
GROUPBUY_ENABLED=false

SALES_SESSION_TTL_HOURS=24
SECRET_REVEAL_TTL_SECONDS=10
ADMIN_CONFIG_LOCK=true
SECRETS_ENCRYPTION_KEY=
SUPER_ADMIN_USER_IDS=
CONNECT_BOOTSTRAP_TOKEN=
ADMIN_ALLOWED_CIDRS=
GROQ_API_KEY=
OPENROUTER_API_KEY=
