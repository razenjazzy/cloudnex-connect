# Logs: put this in /etc/nginx/conf.d/cnx-log-format.conf (http context), then in the amardhaka.io server block:
#   access_log /var/log/nginx/access.log;
#   access_log /var/log/nginx/amardhaka.io.access.log cnx;
#   error_log  /var/log/nginx/amardhaka.io.error.log warn;
# log_format cnx '$msec $remote_addr "$request" $status $body_bytes_sent rt=$request_time ua="$http_user_agent" up=$upstream_addr';
# scripts/vps-log-archive.sh turns these into hourly files for Admin -> Logs.

# TLS is typically certbot-managed. Merge these location blocks into the
# amardhaka.io server{} on the VPS. Do not add this file to other vhosts.
#
# PUBLIC_BASE_URL=https://amardhaka.io/cloudnex-connect
# PUBLIC_ADMIN_BASE=/admin  PUBLIC_DEMO_BASE=/demo
# Node mounts at /cloudnex-connect/admin and /cloudnex-connect/demo (join site path).
# Do not strip the prefix. HMAC webhooks stay on the host root.

# Verification links and shop pay pages under the site path (same app routes as /verify/* and /shop/*).
location ^~ /cloudnex-connect/verify {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}

location ^~ /cloudnex-connect/shop {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}

# LINE webhooks and webhook-test under the site path (same app routes as /webhook*).
# Point each OA's LINE Webhook URL at https://amardhaka.io/cloudnex-connect/webhook/<sales|customer>.
location ^~ /cloudnex-connect/webhook {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Line-Signature $http_x_line_signature;
    proxy_read_timeout 60s;
}

location ^~ /cloudnex-connect/admin/test {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}

location = /cloudnex-connect/admin {
    return 301 /cloudnex-connect/admin/;
}

location /cloudnex-connect/admin/ {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}

# LINE Flex heroes when PUBLIC_BASE_URL is https://host (no /cloudnex-connect path).
location ^~ /catalog/ {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}

# LINE Flex product images (not Admin SPA). Put catalog/test before catalog/.
location ^~ /cloudnex-connect/catalog/test {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}

location /cloudnex-connect/catalog/ {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}

location /cloudnex-connect/demo {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}

location = /cloudnex-connect {
    return 301 /cloudnex-connect/admin/;
}
location = /cloudnex-connect/ {
    return 301 /cloudnex-connect/admin/;
}

location /webhook {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Line-Signature $http_x_line_signature;
    proxy_read_timeout 60s;
}

location = /admin {
    return 301 /cloudnex-connect/admin/;
}
location /admin/ {
    rewrite ^/admin/(.*)$ /cloudnex-connect/admin/$1 permanent;
}
location ^~ /cloudnex-admin/test {
    rewrite ^/cloudnex-admin/test(?:/(.*))?$ /cloudnex-connect/admin/test/$1 permanent;
}
location /cloudnex-admin/ {
    rewrite ^/cloudnex-admin/(.*)$ /cloudnex-connect/admin/$1 permanent;
}
location = /cloudnex-admin {
    return 301 /cloudnex-connect/admin/;
}
location = /demo {
    return 301 /cloudnex-connect/demo;
}
