PORT=8080
# v1.0.0 lanes — see documents/ENVIRONMENTS.md (no extra keys for this release)
# Local:    APP_ENV=development  NODE_ENV=development
# Staging:  APP_ENV=staging      NODE_ENV=production   (VPS image; required)
# Delivery: APP_ENV=production   NODE_ENV=production
APP_ENV=development
NODE_ENV=development

# Optional: keep webhook-test private in production
ENABLE_WEBHOOK_TEST=false
WEBHOOK_TEST_TOKEN=
OPS_API_TOKEN=
MAX_JSON_BODY=64kb
USER_STATE_CACHE_MAX=10000
USER_STATE_CACHE_TTL_MS=3600000
READYZ_TIMEOUT_MS=2500
SHUTDOWN_TIMEOUT_MS=10000
RATE_LIMIT_STORE=memory
RATE_LIMIT_REDIS_PREFIX=rl:
RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_URL=

# Application configuration. User profiles can override language after login.
DEFAULT_LANGUAGE=en
ENABLED_SERVICES=commerce,directory,catalog,reporting,groupBuy
# Comma-separated command prefixes to hide and reject, e.g. QUOTE ADD,QUOTE EDIT
DISABLED_COMMANDS=
LOG_LEVEL=info

# Optional ops platform
# APP_ENV=staging on the VPS (NODE_ENV=production is set by the image):
# ENABLE_DEMO_CONTROL_PANEL=true
# ENABLE_WEBHOOK_TEST=true
# ENABLE_API_DOCS=true
# ENABLE_GRAPHQL=true
# plus DEMO_CONTROL_TOKEN or OPS_API_TOKEN.
# APP_ENV=production ignores ENABLE_DEMO_CONTROL_PANEL and ENABLE_WEBHOOK_TEST.
# ENABLE_API_DOCS=false
# ENABLE_GRAPHQL=false
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=
# MONGODB_URI=
# MONGO_DB_NAME=cns_line_oa
# MONGO_VECTOR_ENABLED=false
# LINE_WEBHOOK_ASYNC=false
# Requires REDIS_URL + RUN_BULLMQ_WORKER=true. Staging compose on the VPS sets
# both and starts Redis. Returns HTTP 200 then workers call replyMessage
# (or pushMessage if the 25s reply token expired). Leave false on Cloud Run
# without a queue. Native tray still replies first; Odoo catalog may push
# after NAV commerce on a cache miss.
# push after NAV commerce on a cache miss. Re-upload assets/rich-menu PNGs into
# LINE_RICH_MENU_JSON / LINE_CHANNEL_CUSTOMER_RICH_MENU_JSON after tray IA changes.
# OPS_JOBS_ASYNC=false
# RUN_BULLMQ_WORKER=false
# BULLMQ_PREFIX=cns

# ERP provider selection. Only 'odoo' is implemented today; any other value
# fails closed at startup rather than silently no-op'ing (src/erp/registry.ts).
ERP_PROVIDER=odoo

# LINE Credentials — Cloudnex Sales default channel (POST /webhook and /webhook/sales fallback)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# OA Basic ID (@handle). Keep the leading @.
LINE_CHANNEL_BASIC_ID=@938qytwi
LINE_CHANNEL_SALES_SECRET=
LINE_CHANNEL_SALES_ACCESS_TOKEN=
LINE_CHANNEL_SALES_BASIC_ID=@938qytwi
LINE_CHANNEL_SALES_SERVICES=
LINE_CHANNEL_SALES_RICH_MENU_JSON=

# Cloudnex Customer (POST /webhook/customer)
LINE_CHANNEL_CUSTOMER_SECRET=
LINE_CHANNEL_CUSTOMER_ACCESS_TOKEN=
LINE_CHANNEL_CUSTOMER_BASIC_ID=@724tneri
LINE_CHANNEL_CUSTOMER_SERVICES=commerce,catalog
LINE_CHANNEL_CUSTOMER_RICH_MENU_JSON=

# Comma-separated LINE user IDs allowed to receive the admin role via ADMIN ENABLE.
# Required (and must include the requesting user) for ADMIN ENABLE to succeed at all.
ADMIN_USER_ID=
SUPER_ADMIN_USER_IDS=
CONNECT_BOOTSTRAP_TOKEN=
SECRETS_ENCRYPTION_KEY=
SECRET_REVEAL_TTL_SECONDS=10
ADMIN_CONFIG_LOCK=true
ADMIN_ALLOWED_CIDRS=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_LINE_CLAIM=line_user_id
OKTA_LINE_USER_MAP=
SAML_IDP_SSO_URL=
SAML_IDP_CERT=
SAML_SP_ENTITY_ID=
SAML_LINE_ATTRIBUTE=line_user_id
LINE_AGENT_NAME_EN=Sora
LINE_AGENT_NAME_TH=โซระ
# After npm run rich-menu:upload — EN Language gold at rest; TH Language idle white.
LINE_RICH_MENU_EN=
LINE_RICH_MENU_TH=
# JSON map from npm run rich-menu:upload — active cell PNGs after a tray tap.
LINE_RICH_MENU_JSON=

# Odoo
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_RPC_TIMEOUT_MS=7000
ODOO_READ_RETRY_ATTEMPTS=3
ODOO_READ_RETRY_BASE_DELAY_MS=250
# Retries for idempotent writes only (update/delete); creates are never
# blindly retried — see src/services/odoo.ts reconciliation comments.
ODOO_WRITE_RETRY_ATTEMPTS=2

# Controlled rollout flags for Group-Buy
GROUPBUY_ENABLED=false
GROUPBUY_ROLLOUT_PERCENT=0
GROUPBUY_ALLOWED_USER_IDS=

# Odoo user verification (OTP + magic link)
PUBLIC_BASE_URL=http://localhost:8080
# Local defaults. VPS primary: /cloudnex-admin and /cloudnex-connect/demo
PUBLIC_ADMIN_BASE=/admin
PUBLIC_DEMO_BASE=/demo
ODOO_VERIFY_OTP_TTL_MINUTES=10
# Max wrong OTP guesses before the verification challenge is invalidated
ODOO_VERIFY_OTP_MAX_ATTEMPTS=5
ODOO_VERIFY_DEBUG_INCLUDE_OTP=false

# Guided step-by-step forms (FORM USER CREATE, FORM SERVICE CREATE, FORM DEMO QUOTE)
GUIDED_FORM_TTL_MINUTES=60
# After this idle period, the next inbound (with no pendingFlow) returns persona Home
LINE_IDLE_HOME_SECONDS=3600
SALES_SESSION_TTL_HOURS=24

# Pricing and cost-control model
AI_INPUT_COST_PER_1M_USD=0.35
AI_OUTPUT_COST_PER_1M_USD=1.25
LINE_MESSAGE_COST_USD=0.0012
ODOO_RPC_COST_USD=0.0008
FIRESTORE_READ_COST_USD=0.000002
FIRESTORE_WRITE_COST_USD=0.00001
INFRA_FIXED_MONTHLY_USD=120
SUPPORT_PER_CUSTOMER_MONTHLY_USD=18
PRICING_BASE_MARKUP_PERCENT=40
PRICING_ADVANCED_MARKUP_PERCENT=70
PRICING_ENTERPRISE_MARKUP_PERCENT=120
PRICING_RISK_BUFFER_PERCENT=12
PRICING_TARGET_MARGIN_PERCENT=65
PRICING_MONTHLY_BUDGET_CAP_USD=2500

# Demo panel production controls
ENABLE_DEMO_CONTROL_PANEL=false
DEMO_CONTROL_TOKEN=
DEMO_SESSION_SECRET=
DEMO_SESSION_TTL_MINUTES=30
DEMO_SESSION_ROTATE_GRACE_MINUTES=30
DEMO_SESSION_CONFIG_KEY=demoSessionSecretsV1
ALLOW_DEMO_HEADER_TOKEN_FALLBACK=false

# Optional AI / Google Cloud integrations
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_AI_STUDIO_API_KEY=
AI_OFF=false
# Only needed on a non-GCP host (e.g. a Railway test deploy), where
# Application Default Credentials aren't available automatically the way
# they are on Cloud Run. Paste a Firestore-capable service account's JSON
# key as a single-line string. Leave unset on Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Audit trail archive & rotation policy (see documents/AUDIT_LOG_POLICY.md).
# Requires GOOGLE_CLOUD_PROJECT (above) for the BigQuery archive; rotation
# safely no-ops (archives/deletes nothing) if that isn't configured.
AUDIT_RETENTION_DAYS=30
AUDIT_ARCHIVE_ENABLED=true
AUDIT_ARCHIVE_DATASET=ops_archive
AUDIT_ARCHIVE_TABLE=audit_log
AUDIT_ROTATE_BATCH_SIZE=500
AUDIT_ROTATE_MAX_BATCHES=20

# Attach your free Groq execution tier token
GROQ_API_KEY=

# Attach your free OpenRouter routing hub token
OPENROUTER_API_KEY=

# clawframework integration (optional) — routes free-form LINE chat through
# clawframework's call_llm (Groq/OpenRouter) instead of Gemini.
#   CLAWFRAMEWORK_ENABLED=true
#   CLAWFRAMEWORK_PROVIDER=groq|openrouter
#   CLAWFRAMEWORK_SEARCH=true|false
#   CLAWFRAMEWORK_PYTHON=/path/to/.venv/bin/python
CLAWFRAMEWORK_ENABLED=false
CLAWFRAMEWORK_PROVIDER=groq
CLAWFRAMEWORK_SEARCH=false

# Optional (default off)
GCS_MEDIA_BUCKET=
LINE_MEDIA_MAX_BYTES=10485760
CLAMAV_URL=
AV_SCAN_REQUIRED=false
LINE_GROUP_ROOMS=false
LINE_SECOND_WEBHOOK=false
MONGO_USERS=false
# Required when MONGO_USERS=true (identity SoR). Never stores Odoo masters.
MONGODB_URI=
GRAPHQL_LINE_INGEST=false
TENANT_KEY=default
