# Cloud Run / preflight template.
# Copy:  cp deploy.env.staging.yaml.example deploy.env.staging.yaml
# Then fill secrets locally. deploy.env.staging.yaml is gitignored.
# npm run preflight:staging  →  scripts/validate-deploy-env.sh staging deploy.env.staging.yaml
#
# Hostinger VPS staging is not this file. It uses dotenv:
#   deploy/env/staging.example  →  /opt/cns-line-oa/.env
# Do not put real API keys in this example.

NODE_ENV: "production"
APP_ENV: "staging"
ENABLE_WEBHOOK_TEST: "true"
ENABLE_DEMO_CONTROL_PANEL: "true"
ALLOW_DEMO_HEADER_TOKEN_FALLBACK: "false"
MAX_JSON_BODY: "64kb"
READYZ_TIMEOUT_MS: "2500"
RATE_LIMIT_STORE: "memory"
GROUPBUY_ENABLED: "false"
GROUPBUY_ROLLOUT_PERCENT: "0"
PUBLIC_BASE_URL: "https://amardhaka.io/cloudnex-connect"
PUBLIC_ADMIN_BASE: "/admin"
ERP_PROVIDER: "odoo"

# JSON-RPC (not postgresql://). Origin + db name from Odoo.sh; login + API key from an Odoo user.
ODOO_URL: "https://YOUR-INSTANCE.dev.odoo.com"
ODOO_DB: "YOUR-ODOO-DB-NAME"
ODOO_USERNAME: ""
ODOO_API_KEY: ""

# shop needs website_sale installed and a positive website id. Unset/quote = quotations.
CUSTOMER_COMMERCE: "shop"
ODOO_WEBSITE_ID: "1"
