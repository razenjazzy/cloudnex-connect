{
  "name": "cloudnex-connect",
  "version": "9.0.9",
  "description": "LINE Official Account + Odoo for Cloudnex: Sales and Customer OAs, identity SoR, Flex quotes, enterprise Admin (campaigns, audit, IdP), dual LINE ingress, and consented messaging.",
  "main": "dist/index.js",
  "bin": {
    "cns": "dist/cli/index.js",
    "cns-mcp": "dist/mcp/server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "postinstall": "npm ci --ignore-scripts --prefix admin",
    "build": "tsc && npm run build --prefix admin",
    "build:admin": "npm run build --prefix admin",
    "cli": "node dist/cli/index.js",
    "mcp": "node dist/mcp/server.js",
    "worker": "node dist/worker.js",
    "preflight:staging": "bash ./scripts/preflight-check.sh staging deploy.env.staging.yaml",
    "preflight:prod": "bash ./scripts/preflight-check.sh production deploy.env.production.yaml",
    "cutover:check:staging": "bash ./scripts/validate-cutover.sh staging deploy.env.staging.yaml",
    "cutover:check:prod": "bash ./scripts/validate-cutover.sh production deploy.env.production.yaml",
    "deploy:validate:staging": "bash ./scripts/validate-deploy-env.sh staging deploy.env.staging.yaml",
    "deploy:validate:prod": "bash ./scripts/validate-deploy-env.sh production deploy.env.production.yaml",
    "deploy:staging": "bash ./scripts/deploy-cloudrun.sh staging",
    "check:line-channels": "bash ./scripts/check-line-channels.sh",
    "deploy:staging-vm": "bash ./scripts/deploy-cloudnex-connect-staging.sh",
    "deploy:vps-staging": "bash ./scripts/deploy-cloudnex-connect-staging.sh",
    "deploy:prod": "bash ./scripts/require-production-signoff.sh && bash ./scripts/deploy-cloudrun.sh production",
    "validate:staging": "bash ./scripts/validate-staging.sh",
    "release:staging": "npm test && npm run build && bash ./scripts/validate-staging.sh",
    "smoke": "bash ./scripts/smoke-check.sh",
    "evidence": "bash ./scripts/generate-deploy-evidence.sh",
    "cloudflare": "bash ./scripts/deploy-cloudflare.sh",
    "runner": "bash ./scripts/runner.sh",
    "runner:backend:build": "bash ./scripts/runner.sh backend:build",
    "runner:backend:test": "bash ./scripts/runner.sh backend:test",
    "runner:claw:check": "bash ./scripts/runner.sh claw:check",
    "runner:claw:run": "bash ./scripts/runner.sh claw:run",
    "runner:health": "bash ./scripts/runner.sh health",
    "runner:cloudrun": "bash ./scripts/runner.sh cloudrun",
    "runner:railway": "bash ./scripts/runner.sh railway",
    "railway:login": "npx --yes @railway/cli login",
    "railway:status": "npx --yes @railway/cli status",
    "railway:check": "npx --yes @railway/cli whoami && npx --yes @railway/cli status && curl -sS https://cns-line-oa-production.up.railway.app/healthz && echo && curl -sS https://cns-line-oa-production.up.railway.app/readyz | python3 -c 'import json,sys; d=json.load(sys.stdin); print(\"ready\", d.get(\"ready\"), \"appEnv check via /healthz\")'",
    "railway:push-staging": "node scripts/push-railway-staging-env.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:validators": "vitest run tests/command-validators.test.ts",
    "rich-menu:generate": "node scripts/generate-rich-menu.mjs",
    "rich-menu:upload": "node scripts/upload-rich-menu.mjs",
    "journey:stills": "ts-node --transpile-only scripts/export-journey-stills.ts",
    "lint": "eslint src tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google-cloud/bigquery": "^8.3.1",
    "@google-cloud/firestore": "^8.6.0",
    "@google/genai": "^2.10.0",
    "@line/bot-sdk": "^11.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bullmq": "^5.81.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^173.0.0",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.22.0",
    "ioredis": "^6.0.0",
    "mongodb": "^7.6.0",
    "pino": "^10.3.1",
    "redis": "^5.12.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@line/line-bot-mcp-server": "^0.5.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.8.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
